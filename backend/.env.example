# ==========================================
# Psyco AI Backend Environment Configuration
# ==========================================
# Copy this file to .env and configure with appropriate values.
# NEVER commit the real .env file or real secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Application Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SESSION_DURATION_MINUTES=50
DEFAULT_BUFFER_TIME_MINUTES=10

# Firebase Configuration (Required in Phase 2)
# The database MUST be Firebase Realtime Database. Firebase Storage is NOT used.
FIREBASE_PROJECT_ID=psyco-ai-demo-placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@psyco-ai-demo-placeholder.iam.gserviceaccount.com
# Use literal private key string with escaped newlines \n, or path to service account key file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3placeholder\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://psyco-ai-demo-placeholder-default-rtdb.firebaseio.com

# External Integration Credentials (Planned for subsequent phases)
# Leave empty during Phase 0 - boundary adapters gracefully detect unconfigured states.

# Google Calendar & Meet OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback

# Google Gemini API Key (Phase 6 - Clinical Documentation Copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AssemblyAI API Key (Phase 5 - Ambient Session Transcription)
ASSEMBLYAI_API_KEY=

# Background Job Queue (Phase 6)
REDIS_URL=redis://localhost:6379

# Phase 6.3 AI Sandbox & Vendor Privacy Safeguards
GEMINI_PROVIDER=mock
GEMINI_CLINICAL_LIVE_ENABLED=false
ASSEMBLYAI_LIVE_ENABLED=false
AI_SANDBOX_MODE=true
