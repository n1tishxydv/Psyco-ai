# ==============================================================================
# PSYCO AI — STAGING BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL.
# Copy this file to backend/.env.staging and populate with isolated staging credentials.
# Verify that staging credentials NEVER point to production Firebase or external resources.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=staging
API_PREFIX=/api/v1
# Deployed Firebase Hosting URL (e.g., https://psyco-ai-staging.web.app)
FRONTEND_URL=https://psyco-ai-staging.web.app

# Clinical Practice Management Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SESSION_DURATION_MINUTES=50
DEFAULT_BUFFER_TIME_MINUTES=10

# Staging Firebase Authentication & Realtime Database Configuration
# Point strictly to the dedicated staging Firebase project
FIREBASE_PROJECT_ID=psyco-ai-staging
FIREBASE_DATABASE_URL=https://psyco-ai-staging-default-rtdb.firebaseio.com
FIREBASE_API_KEY=YOUR_STAGING_FIREBASE_WEB_API_KEY
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@psyco-ai-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_STAGING_SERVICE_ACCOUNT_PRIVATE_KEY_PEM\n-----END PRIVATE KEY-----\n"

# Google Calendar & Meet OAuth Configuration (Staging Client Credentials)
# Authorized Redirect URI must match the deployed Render backend domain callback
GOOGLE_CALENDAR_API_KEY=YOUR_STAGING_GOOGLE_CALENDAR_API_KEY
GOOGLE_CLIENT_ID=YOUR_STAGING_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_STAGING_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_RENDER_SERVICE_NAME.onrender.com/api/v1/integrations/google/callback

# Google Gemini Clinical Copilot Integration
GEMINI_API_KEY=YOUR_STAGING_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# AssemblyAI Ambient Streaming Transcription
ASSEMBLYAI_API_KEY=YOUR_STAGING_ASSEMBLYAI_API_KEY

# Optional Cache / Queue Store
REDIS_URL=
