{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid && (!data.exists() || !newData.child('role').exists() || newData.child('role').val() === data.child('role').val()))",
        ".validate": "newData.hasChildren(['uid', 'email'])"
      }
    },
    "patients": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'psychologist')",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName', 'gender', 'age'])"
      }
    },
    "psychologists": {
      "$uid": {
        ".read": "true",
        ".write": "auth != null && auth.uid === $uid && (!newData.child('approvalStatus').exists() || newData.child('approvalStatus').val() === data.child('approvalStatus').val())"
      }
    },
    "patientIntake": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'psychologist')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "intakeTemplates": {
      "$uid": {
        ".read": "true",
        ".write": "auth != null && (auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'psychologist')"
      }
    },
    "availability": {
      "$uid": {
        ".read": "true",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "appointments": {
      ".read": "auth != null",
      "$appointmentId": {
        ".read": "auth != null && (data.child('patientId').val() === auth.uid || data.child('psychologistId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (data.child('patientId').val() === auth.uid || data.child('psychologistId').val() === auth.uid || !data.exists())"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "googleConnections": {
      ".read": false,
      ".write": false
    },
    "userPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessionRecords": {
      "$sessionId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "sessionNotes": {
      "$noteId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && (data.child('psychologistId').val() === auth.uid || (data.child('patientId').val() === auth.uid && data.child('sharedWithPatient').val() === true))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "treatmentPlans": {
      "$planId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || (data.child('patientId').val() === auth.uid && data.child('sharedWithPatient').val() === true))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "followUpTasks": {
      "$taskId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)"
      }
    },
    "clinicalRecommendations": {
      "$recId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "reports": {
      "$reportId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "sessionTranscripts": {
      "$transcriptId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && (data.child('psychologistId').val() === auth.uid || (data.child('patientId').val() === auth.uid && data.child('sharedWithPatient').val() === true))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "transcriptEntries": {
      "$transcriptId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && (root.child('sessionTranscripts').child($transcriptId).child('psychologistId').val() === auth.uid || (root.child('sessionTranscripts').child($transcriptId).child('patientId').val() === auth.uid && root.child('sessionTranscripts').child($transcriptId).child('sharedWithPatient').val() === true))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "transcriptVersions": {
      "$transcriptId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "consentRecords": {
      "$consentId": {
        ".read": "auth != null && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null"
      }
    },
    "aiJobs": {
      "$jobId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && data.child('psychologistId').val() === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "aiDrafts": {
      "$draftId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && data.child('psychologistId').val() === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "assessmentAssignments": {
      "$assignmentId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null"
      }
    },
    "assessmentResults": {
      "$resultId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() != 'admin' && (data.child('psychologistId').val() === auth.uid || data.child('patientId').val() === auth.uid)",
        ".write": "auth != null"
      }
    },
    "riskReviewFlags": {
      "$flagId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist' && data.child('psychologistId').val() === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist'"
      }
    },
    "documentationFindings": {
      "$psychologistId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist' && auth.uid === $psychologistId",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'psychologist' && auth.uid === $psychologistId"
      }
    },
    "auditLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    }
  }
}
