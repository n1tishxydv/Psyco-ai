{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/api/v1/integrations/google/callback",
        "destination": "https://psyco-ai.onrender.com/api/v1/integrations/google/callback",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
