# ==============================================================================
# PSYCO AI — STAGING FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL.
# Copy this file to frontend/.env.staging and populate with staging client settings.
# Notice: NEVER place service account private keys or backend secrets in frontend env.
# ==============================================================================

# Backend REST API Staging URL
VITE_API_BASE_URL=https://api-staging.psyco-ai.app/api/v1

# Staging Firebase Client Configuration (Isolated Staging Firebase Project)
VITE_FIREBASE_API_KEY=YOUR_STAGING_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=psyco-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=psyco-staging
VITE_FIREBASE_DATABASE_URL=https://psyco-staging-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=psyco-staging.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-STAGING0000
